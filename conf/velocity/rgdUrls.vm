## Base URLs of the RGD webapps these templates link to.
##
## Solr does not bind request-handler params to Velocity variables on its own - they
## have to be pulled off $params - so every template that uses these URLs must
## #parse this file.
##
## Solr runs on ontomate.rgd.mcw.edu (prod) and dev.rgd.mcw.edu (dev), but rgdweb.war
## is deployed only on rgd.mcw.edu and dev.rgd.mcw.edu, so the rgdweb host can never be
## assumed to be the host serving this page. It is resolved in this order:
##
##   1. the rgdWebUrl invariant in solrconfig.xml (-Drgdweb.url in the Solr start
##      options) - a trusted per-server setting, so it wins when present;
##   2. the curHost request param the curation app already passes, but only when it
##      names a host that actually has rgdweb.war. Checking it against that list keeps
##      a client from injecting its own host and rewriting every link on the page;
##   3. production.
#set($rgdWebHosts = ["rgd.mcw.edu", "dev.rgd.mcw.edu"])
#set($rgdWebUrl = $params.get('rgdWebUrl'))
#if(!$rgdWebUrl || $rgdWebUrl == "")
#set($curHostParam = $params.get('curHost'))
#if($curHostParam && $curHostParam != "")
#set($curHostLower = $curHostParam.toLowerCase())
#end
#if($curHostLower && $rgdWebHosts.contains($curHostLower))
#set($rgdWebUrl = "https://${curHostLower}/rgdweb")
#else
#set($rgdWebUrl = "https://rgd.mcw.edu/rgdweb")
#end
#end
## The curation app (rgdCuration) and the Solr endpoint itself: per-server values come
## from the rgdCurationUrl / solrUrl invariants (-DrgdCuration.url / -Drgd.solr.url).
#set($rgdCurationUrl = $params.get('rgdCurationUrl'))
#if(!$rgdCurationUrl || $rgdCurationUrl == "")
#set($rgdCurationUrl = "https://pipelines.rgd.mcw.edu/rgdCuration")
#end
#set($solrUrl = $params.get('solrUrl'))
#if(!$solrUrl || $solrUrl == "")
#set($solrUrl = "https://ontomate.rgd.mcw.edu/solr")
#end
